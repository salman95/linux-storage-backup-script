[Unit]
Description=Homelab Control Web UI
After=network.target

[Service]
Type=simple
User=salman95
WorkingDirectory=/home/salman95/linux-storage-backup-script
ExecStart=/usr/bin/python3 /home/salman95/linux-storage-backup-script/backup_web.py
Restart=on-failure
RestartSec=5
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target
